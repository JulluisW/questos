# Copy to .env.local and fill in.

# Public address of the site, for metadata, robots.txt and the sitemap.
# Optional on Vercel (it falls back to the production URL Vercel provides).
# NEXT_PUBLIC_SITE_URL=https://questos.example.com

# Supabase (Project Settings -> API, or `supabase status` for the local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Oracle: pick ONE provider.
# Local (default in development): Ollama with an OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Hosted: setting this switches the Oracle to OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional
# AI_HOURLY_LIMIT=10      # Oracle consultations per user per hour
# AI_DISABLED=true        # hide the Oracle entirely
